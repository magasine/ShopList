{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "dist/**",
      "build.sh",
      "wrangler.jsonc",
      "_headers",
      "*.md",
      "LICENSE",
      "*-Shop-List.json",
      "img_icon_ShopList.jpeg"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
